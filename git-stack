#!/usr/bin/env python3
"""git stack: manage stacked branches that survive squash merges.

Each tracked branch records two things in git config:

  branch.<name>.stackParent  the branch it is stacked on (e.g. pr1, or main)
  branch.<name>.stackBase    the parent commit it was last rebased onto

Knowing the base lets us replay only the branch's own commits with
`git rebase --onto <parent> <base> <branch>`, so a parent that was squash-merged
(and whose individual commits therefore never appear in main) doesn't cause
conflicts.

A third key, branch.<name>.stackPulled, records the last upstream tip whose
commits were pulled into the branch, so a pull whose conflicts the user resolved
isn't repeated, and branch.<name>.stackPr records the number of the branch's
pull request when the GitHub adapter opened or found one.

How a merge is detected depends on the adapter (the stack.adapter setting): the
git adapter only looks at the repository, and the GitHub adapter asks GitHub
about each branch's pull request first.
"""

import argparse
import enum
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

PARENT_KEY = "stackParent"
BASE_KEY = "stackBase"
PULLED_KEY = "stackPulled"
PR_KEY = "stackPr"
# Written before a rebase starts and promoted to PARENT_KEY/BASE_KEY once the
# rebase is known to have finished. This lets the user resolve conflicts with a
# plain `git rebase --continue` (or back out with `git rebase --abort`).
PENDING_PARENT_KEY = "stackPendingParent"
PENDING_BASE_KEY = "stackPendingBase"
# Same idea for pulling upstream commits with `git cherry-pick`: the branch tip
# before the pull, and the upstream tip being pulled.
PENDING_PULL_FROM_KEY = "stackPendingPullFrom"
PENDING_PULLED_KEY = "stackPendingPulled"

# raw.githubusercontent.com caches branch URLs for minutes, so upgrade resolves
# the ref to a commit with the API first and downloads the file at that commit.
COMMIT_API_URL = "https://api.github.com/repos/benekastah/git-stack/commits/{ref}"
SCRIPT_URL = "https://raw.githubusercontent.com/benekastah/git-stack/{commit}/git-stack"

ADAPTER_SETTING = "stack.adapter"
DEFAULT_REMOTE = "origin"
# Matches https://host/owner/repo, ssh://user@host:port/owner/repo and
# user@host:owner/repo, with or without .git.
REMOTE_URL = re.compile(r"^(?:[a-z+]+://)?(?:[^@/]+@)?([^:/]+)(?::\d+)?[:/]([^/]+)/([^/]+?)(?:\.git)?/?$")
PR_FIELDS = "number state headRefOid baseRefName mergeCommit { oid }"


class StackError(Exception):
    pass


class BrokenStackError(StackError):
    """A branch's metadata doesn't match the repository, so it can't be restacked."""


def git(*args, check=True, input=None):
    """Run git and return stripped stdout."""
    result = subprocess.run(["git", *args], capture_output=True, text=True, input=input)
    if check and result.returncode != 0:
        raise StackError(f"git {' '.join(args)} failed:\n{result.stderr.strip()}")
    return result.stdout.strip()


def git_ok(*args):
    """Run git and report whether it succeeded."""
    return subprocess.run(["git", *args], capture_output=True).returncode == 0


def git_passthrough(*args):
    """Run git with output going straight to the terminal."""
    return subprocess.run(["git", *args]).returncode == 0


def config_get(branch, key):
    value = git("config", "--get", f"branch.{branch}.{key}", check=False)
    return value or None


def config_set(branch, key, value):
    git("config", f"branch.{branch}.{key}", value)


def config_unset(branch, key):
    git("config", "--unset", f"branch.{branch}.{key}", check=False)


def rev(ref):
    return git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", check=False) or None


def is_ancestor(ancestor, descendant):
    return git_ok("merge-base", "--is-ancestor", ancestor, descendant)


def current_branch():
    return git("branch", "--show-current") or None


def local_branch_exists(name):
    return git_ok("show-ref", "--verify", "--quiet", f"refs/heads/{name}")


def tracked_branches():
    """Return {branch: parent} for every tracked branch that still exists."""
    out = git("config", "--null", "--get-regexp", rf"^branch\..*\.{PARENT_KEY.lower()}$", check=False)
    suffix = f".{PARENT_KEY.lower()}"
    parents = {}
    for entry in filter(None, out.split("\0")):
        key, _, value = entry.partition("\n")
        branch = key[len("branch."):-len(suffix)]
        if local_branch_exists(branch):
            parents[branch] = value
    return parents


def children_map(parents):
    children = {}
    for branch, parent in sorted(parents.items()):
        children.setdefault(parent, []).append(branch)
    return children


def descendants(root, children):
    """Return root's descendants in parent-before-child order (root excluded)."""
    order = []
    for child in children.get(root, []):
        order.append(child)
        order.extend(descendants(child, children))
    return order


def ancestry(branch, parents):
    """Return [branch, its parent, ..., the first untracked ancestor]."""
    chain = [branch]
    while chain[-1] in parents:
        parent = parents[chain[-1]]
        if parent in chain:
            raise StackError(f"cycle in stack metadata involving {parent}")
        chain.append(parent)
    return chain


def stack_root(branch, parents):
    """Walk up from branch to the first untracked ancestor (usually main)."""
    return ancestry(branch, parents)[-1]


def ensure_no_cycle(branch, new_parent, parents):
    if branch in ancestry(new_parent, parents):
        raise StackError(f"{new_parent} is stacked on {branch}; that would create a cycle")


def stack_of(branch, parents):
    """Tracked branches in the stack containing branch, parent-before-child.

    For a tracked branch this is everything stacked on the same root that
    shares its bottom-most tracked ancestor. For an untracked branch (e.g.
    main) it is everything stacked on top of it.
    """
    children = children_map(parents)
    if branch not in parents:
        return descendants(branch, children)
    bottom = ancestry(branch, parents)[-2]
    return [bottom, *descendants(bottom, children)]


def operation_in_progress():
    """Whether a rebase, cherry-pick or merge has stopped and is waiting for the user."""
    return any(os.path.exists(git("rev-parse", "--git-path", name))
               for name in ("rebase-merge", "rebase-apply", "CHERRY_PICK_HEAD", "MERGE_HEAD"))


def ensure_no_operation_in_progress():
    if operation_in_progress():
        raise StackError("a rebase, cherry-pick or merge is in progress; finish it with "
                         "`--continue` (or `--abort`), then rerun this command")


def ensure_clean_worktree():
    if git("status", "--porcelain", "--untracked-files=no"):
        raise StackError("you have uncommitted changes; commit or stash them first")


def settle(branch):
    """Record the result of an interrupted restack or pull, if there was one.

    If the rebase finished, the pending parent commit is now in the branch's
    history and becomes the new base. If it was aborted, it isn't, and the
    previous parent and base are kept.

    Likewise, if the cherry-pick of upstream commits moved the branch forward,
    the upstream tip counts as pulled. If it was aborted, the branch is back
    where it started and the next sync tries again.

    Must not be called while a rebase or cherry-pick is in progress, since the
    branch hasn't been updated yet.
    """
    pending_parent = config_get(branch, PENDING_PARENT_KEY)
    if pending_parent is not None:
        pending_base = config_get(branch, PENDING_BASE_KEY)
        if pending_base and is_ancestor(pending_base, branch):
            config_set(branch, PARENT_KEY, pending_parent)
            config_set(branch, BASE_KEY, pending_base)
        config_unset(branch, PENDING_PARENT_KEY)
        config_unset(branch, PENDING_BASE_KEY)

    pending_pulled = config_get(branch, PENDING_PULLED_KEY)
    if pending_pulled is not None:
        pull_from = config_get(branch, PENDING_PULL_FROM_KEY)
        if pull_from and rev(branch) != pull_from and is_ancestor(pull_from, branch):
            config_set(branch, PULLED_KEY, pending_pulled)
        config_unset(branch, PENDING_PULLED_KEY)
        config_unset(branch, PENDING_PULL_FROM_KEY)


def settle_all():
    for branch in tracked_branches():
        settle(branch)


def recorded_base(branch, parent):
    """Return branch's base, checking that it is still in the branch's history."""
    base = config_get(branch, BASE_KEY)
    if base is None or not is_ancestor(base, branch):
        raise BrokenStackError(f"{branch}'s recorded base isn't in its history (was it rebased by hand?); "
                               f"fix it with `git stack track {parent} --base <sha>`")
    return base


def squash_branch(branch, parent):
    """Squash branch's own commits into one, keeping its base.

    The commit gets every squashed commit's message, oldest first, and the
    oldest commit's author and date.
    """
    base = recorded_base(branch, parent)
    commits = git("rev-list", "--reverse", f"{base}..refs/heads/{branch}").split()
    if len(commits) < 2:
        return
    print(f"squashing {len(commits)} commits on {branch}")
    message = "\n\n".join(git("show", "--no-patch", "--format=%B", c) for c in commits)
    author, date = git("show", "--no-patch", "--format=%an <%ae>%x00%aI", commits[0]).split("\0")
    git("switch", "--quiet", branch)
    git("reset", "--quiet", "--soft", base)
    git("commit", "--quiet", "--no-verify", "--cleanup=whitespace",
        f"--author={author}", f"--date={date}", "--file=-", input=message)


def restack_branch(branch, parent):
    """Rebase branch's own commits onto parent's current tip.

    parent may differ from the recorded one (restack --onto); it is recorded
    only once the rebase has finished.
    """
    parent_tip = rev(parent)
    if parent_tip is None:
        raise BrokenStackError(f"{branch}'s parent {parent} doesn't exist; "
                               f"retarget it with `git stack track <parent> --base <sha>`")
    base = recorded_base(branch, parent)
    if base == parent_tip:
        # Nothing to replay, so there's no rebase to wait for.
        config_set(branch, PARENT_KEY, parent)
        return
    print(f"restacking {branch} onto {parent}")
    config_set(branch, PENDING_PARENT_KEY, parent)
    config_set(branch, PENDING_BASE_KEY, parent_tip)
    if git_passthrough("rebase", "--no-update-refs", "--onto", parent_tip, base, branch):
        settle(branch)
    elif operation_in_progress():
        raise StackError(f"restacking {branch} stopped on a conflict. Resolve it, run "
                         f"`git rebase --continue`, then rerun this command to finish the stack")
    else:
        config_unset(branch, PENDING_PARENT_KEY)
        config_unset(branch, PENDING_BASE_KEY)
        raise StackError(f"restacking {branch} onto {parent} failed; see git's output above")


def reflog_tips(branch):
    """Every commit branch has pointed at, as far back as its reflog goes."""
    return git("log", "--walk-reflogs", "--format=%H", f"refs/heads/{branch}", check=False).split()


def unpulled_commits(branch, parent, upstream_tip):
    """Non-merge commits on upstream_tip that branch doesn't have, oldest first.

    A commit counts as already present if branch (or parent) contains it or an
    equivalent patch, if branch ever pointed at it or a descendant of it (so the
    old copies of commits we have since rebased don't count), or if an earlier
    pull already took it.
    """
    known = [f"refs/heads/{branch}", *reflog_tips(branch)]
    for ref in (parent, config_get(branch, PULLED_KEY)):
        if ref and rev(ref):
            known.append(rev(ref))
    unknown = set(git("rev-list", "--no-merges", upstream_tip, "--not", *known).split())
    if not unknown:
        return []
    new_patches = git("rev-list", "--reverse", "--topo-order", "--no-merges", "--cherry-pick",
                      "--right-only", f"refs/heads/{branch}...{upstream_tip}").split()
    return [commit for commit in new_patches if commit in unknown]


def pull_upstream(branch, parent):
    """Cherry-pick commits that others pushed to branch's upstream onto branch."""
    upstream_tip = rev(f"{branch}@{{upstream}}")
    if upstream_tip is None:
        return
    commits = unpulled_commits(branch, parent, upstream_tip)
    if not commits:
        return
    print(f"pulling {len(commits)} new commit(s) from {branch}'s upstream")
    config_set(branch, PENDING_PULL_FROM_KEY, rev(branch))
    config_set(branch, PENDING_PULLED_KEY, upstream_tip)
    git("switch", "--quiet", branch)
    if not git_passthrough("cherry-pick", "--ff", *commits):
        raise StackError(f"pulling upstream commits into {branch} stopped on a conflict. Resolve it, "
                         f"run `git cherry-pick --continue`, then rerun `git stack sync`")
    settle(branch)


def restack_all(branches, parents):
    original = current_branch()
    for branch in branches:
        restack_branch(branch, parents[branch])
    if original and current_branch() != original:
        git("switch", "--quiet", original)


def cmd_branch(args):
    parent = current_branch()
    if parent is None:
        raise StackError("not on a branch")
    git("switch", "--quiet", "--create", args.name)
    config_set(args.name, PARENT_KEY, parent)
    config_set(args.name, BASE_KEY, rev("HEAD"))
    print(f"created {args.name} on top of {parent}")


def cmd_track(args):
    branches = args.branches
    if not branches:
        branch = current_branch()
        if branch is None:
            raise StackError("not on a branch")
        branches = [branch]
    if rev(args.parent) is None:
        raise StackError(f"{args.parent} isn't a commit")
    for branch in branches:
        if not local_branch_exists(branch):
            raise StackError(f"{branch} isn't a local branch")
    if len(set(branches)) != len(branches) or args.parent in branches:
        raise StackError("each branch can only appear once")

    # Validate the whole chain before writing anything, so a bad argument
    # doesn't leave the stack half-tracked.
    parents = tracked_branches()
    plan = []
    parent, base_arg = args.parent, args.base
    for branch in branches:
        ensure_no_cycle(branch, parent, parents)
        base = rev(base_arg) if base_arg else git("merge-base", parent, branch, check=False) or None
        if base is None:
            raise StackError(f"{base_arg} isn't a commit" if base_arg
                             else f"{branch} has no history in common with {parent}")
        if not is_ancestor(base, branch):
            raise StackError(f"{base_arg} isn't in {branch}'s history")
        parents[branch] = parent
        plan.append((branch, parent, base))
        parent, base_arg = branch, None

    for branch, parent, base in plan:
        config_set(branch, PARENT_KEY, parent)
        config_set(branch, BASE_KEY, base)
        print(f"tracking {branch} on top of {parent} (base {base[:12]})")


def cmd_rename(args):
    ensure_no_operation_in_progress()
    settle_all()
    old = args.old or current_branch()
    if old is None:
        raise StackError("not on a branch; name the branch to rename")
    if not local_branch_exists(old):
        raise StackError(f"{old} isn't a local branch")
    upstream = git("rev-parse", "--abbrev-ref", f"{old}@{{upstream}}", check=False)
    children = [child for child, parent in tracked_branches().items() if parent == old]
    git("branch", "--move", old, args.name)
    # Its pull request stays on the old remote branch, so the next push opens
    # a new one.
    config_unset(args.name, PR_KEY)
    for child in children:
        config_set(child, PARENT_KEY, args.name)
    print(f"renamed {old} to {args.name}" +
          (f" and moved {', '.join(children)} onto it" if children else ""))
    if upstream:
        # Leaving the old upstream would make sync pull from it, and report it
        # as gone once it's deleted.
        git("branch", "--unset-upstream", args.name)
        print(f"note: {upstream} wasn't renamed, and pull requests on it or based on it still point "
              f"there. `git stack push` will push {args.name} as a new remote branch")


def cmd_info(args):
    # Pick up the result of a rebase the user finished by hand, but leave the
    # pending state alone while it's still running.
    if not operation_in_progress():
        settle_all()
    parents = tracked_branches()
    if not parents:
        print("no tracked branches")
        return
    current = current_branch()
    children = children_map(parents)
    roots = sorted({stack_root(b, parents) for b in parents})
    adapter = make_adapter(DEFAULT_REMOTE)

    def label(branch):
        notes = []
        if branch == current:
            notes.append("*")
        if branch in parents:
            parent = parents[branch]
            parent_tip = rev(parent)
            state = parent_tip and adapter.merge_state(branch, parent)
            if parent_tip is None:
                notes.append(f"(parent {parent} missing)")
            elif state is not MergeState.NOT_MERGED:
                notes.append(f"({state.value})")
            elif config_get(branch, BASE_KEY) != parent_tip:
                notes.append("(needs restack)")
        return " ".join([branch, *notes])

    def show(branch, prefix):
        kids = children.get(branch, [])
        for i, kid in enumerate(kids):
            last = i == len(kids) - 1
            print(f"{prefix}{'└── ' if last else '├── '}{label(kid)}")
            show(kid, prefix + ("    " if last else "│   "))

    for root in roots:
        print(label(root))
        show(root, "")


def cmd_restack(args):
    ensure_no_operation_in_progress()
    ensure_clean_worktree()
    settle_all()
    branch = current_branch()
    if branch is None:
        raise StackError("not on a branch")
    parents = tracked_branches()
    if args.onto:
        if rev(args.onto) is None:
            raise StackError(f"{args.onto} isn't a commit")
        if branch not in parents:
            raise StackError(f"{branch} isn't tracked; use `git stack track` first")
        ensure_no_cycle(branch, args.onto, parents)
        parents[branch] = args.onto
    if args.squash and branch not in parents:
        raise StackError(f"{branch} isn't in a stack; run `restack --squash` from a stacked branch "
                         f"to squash only that stack")
    branches = skip_merged(stack_of(branch, parents), parents, make_adapter(DEFAULT_REMOTE))
    if args.squash:
        original = current_branch()
        for b in branches:
            squash_branch(b, parents[b])
        if current_branch() != original:
            git("switch", "--quiet", original)
    restack_all(branches, parents)


def fast_forward_trunks(roots):
    """Fast-forward untracked local parents (e.g. main) to their upstreams."""
    current = current_branch()
    for root in roots:
        if not local_branch_exists(root):
            continue
        upstream = git("rev-parse", "--abbrev-ref", f"{root}@{{upstream}}", check=False)
        if not upstream:
            continue
        old, new = rev(root), rev(upstream)
        if old == new:
            continue
        if not is_ancestor(old, new):
            print(f"warning: {root} has diverged from {upstream}; not updating it", file=sys.stderr)
            continue
        if root == current:
            git("merge", "--ff-only", "--quiet", upstream)
        else:
            git("update-ref", f"refs/heads/{root}", new, old)
        print(f"fast-forwarded {root} to {upstream}")


def upstream_gone(branch):
    return git("for-each-ref", "--format=%(upstream:track)", f"refs/heads/{branch}") == "[gone]"


def contained_in(branch, target):
    """Whether merging branch into target would change nothing.

    This is true after a squash merge even though none of branch's commits are
    in target's history.
    """
    result = subprocess.run(
        ["git", "merge-tree", "--write-tree", target, branch], capture_output=True, text=True)
    if result.returncode != 0:
        return False
    merged_tree = result.stdout.splitlines()[0]
    return merged_tree == git("rev-parse", f"{target}^{{tree}}")


def changes_something(branch):
    """Whether branch's tree differs from its recorded base's.

    False for a branch with no commits of its own yet, and when the base is
    missing or not in its history.
    """
    base = config_get(branch, BASE_KEY)
    if base is None or not is_ancestor(base, branch):
        return False
    return not git_ok("diff", "--quiet", base, f"refs/heads/{branch}")


def patch_ids(*args):
    """The patch-ids of the commits or diff that `git <args>` prints."""
    command, *rest = args
    patches = git("--literal-pathspecs", command, "--no-color", "--no-ext-diff", *rest)
    return {line.split()[0] for line in git("patch-id", "--stable", input=patches + "\n").splitlines()}


def landed_as_patches(branch, parent):
    """Whether parent has branch's changes as one squashed commit, or as
    commits with the same changes as each of branch's.

    Unlike contained_in, this still holds after parent edits the same lines
    again.
    """
    base = config_get(branch, BASE_KEY)
    if base is None or not is_ancestor(base, branch) or rev(parent) is None:
        return False
    files = git("diff", "--name-only", "-z", base, f"refs/heads/{branch}").split("\0")
    files = [f for f in files if f]
    if not files:
        return False
    # Only parent's commits that touch the same files can match.
    landed = patch_ids("log", "-p", "--no-merges", "--full-diff", parent,
                       "--not", f"refs/heads/{branch}", "--", *files)
    if patch_ids("diff", base, f"refs/heads/{branch}") & landed:
        return True
    own = patch_ids("log", "-p", "--no-merges", f"{base}..refs/heads/{branch}")
    return bool(own) and own <= landed


class MergeState(enum.Enum):
    NOT_MERGED = "not merged"
    MERGED = "merged"
    # Merged, but the branch or its remote branch has commits that weren't.
    MERGED_WITH_NEW_COMMITS = "merged, with new commits"


class GitAdapter:
    """Works out whether branches were merged from the repository alone."""

    def merge_state(self, branch, parent):
        """Whether branch has landed in parent, so dropping it loses nothing.

        Its changes must be in parent. Unless its remote branch was deleted
        (which is all the evidence of a merge we need), the branch must also
        change something, so a new branch with no commits isn't mistaken for a
        merged one, and if it has a remote branch, commits pushed there after
        the merge make it MERGED_WITH_NEW_COMMITS, so they aren't dropped.
        """
        if not (contained_in(branch, parent) or landed_as_patches(branch, parent)):
            return MergeState.NOT_MERGED
        if upstream_gone(branch):
            return MergeState.MERGED
        if not changes_something(branch):
            return MergeState.NOT_MERGED
        upstream_tip = rev(f"{branch}@{{upstream}}")
        if (upstream_tip and not contained_in(upstream_tip, parent)
                and unpulled_commits(branch, parent, upstream_tip)):
            return MergeState.MERGED_WITH_NEW_COMMITS
        return MergeState.MERGED

    def after_push(self, branch, branches, parents):
        """Called once branches were pushed: the stack containing branch, less the
        branches that were merged (possibly including branch itself)."""


def unmerged_commits(ref, merged_head, parent):
    """Non-merge commits on ref that aren't in parent and don't match a commit on merged_head."""
    unmatched = git("rev-list", "--cherry-pick", "--right-only", "--no-merges", f"{merged_head}...{ref}")
    return set(unmatched.split()) & set(git("rev-list", "--no-merges", ref, "--not", parent).split())


class GitHubAdapter(GitAdapter):
    """Asks GitHub, through the gh CLI, whether each branch's pull request was
    merged, and opens draft pull requests when branches are pushed.

    Branches without a merged pull request (for example, one merged into its
    parent locally) are checked like GitAdapter does, unless their parent is
    the repository's default branch, which we assume nobody merges into
    locally.
    """

    def __init__(self, host, owner, name):
        self.host, self.owner, self.name = host, owner, name
        self.repo = f"{host}/{owner}/{name}"
        self._pull_requests = None
        self._default_branch = None

    def gh(self, *args):
        result = subprocess.run(["gh", *args], capture_output=True, text=True)
        if result.returncode != 0:
            raise StackError(f"gh {' '.join(args)} failed:\n{result.stderr.strip()}")
        return result.stdout.strip()

    def pull_requests(self):
        """{branch: pull request} for tracked branches with a recorded pull request.

        Looked up with one API call per command. If that fails, warns and
        returns {}, so merges are only detected locally.
        """
        if self._pull_requests is None:
            self._pull_requests = {}
            numbers = {}
            for branch in tracked_branches():
                number = config_get(branch, PR_KEY)
                if number and number.isdigit():
                    numbers[branch] = int(number)
            if not numbers:
                return self._pull_requests
            fields = " ".join(f"pr{n}: pullRequest(number: {n}) {{ {PR_FIELDS} }}"
                              for n in sorted(set(numbers.values())))
            query = (f"query($owner: String!, $name: String!) {{ repository(owner: $owner, name: $name) "
                     f"{{ defaultBranchRef {{ name }} {fields} }} }}")
            try:
                out = self.gh("api", "graphql", "--hostname", self.host, "-f", f"owner={self.owner}",
                              "-f", f"name={self.name}", "-f", f"query={query}")
                found = json.loads(out)["data"]["repository"]
                self._pull_requests = {branch: found[f"pr{n}"] for branch, n in numbers.items()
                                       if found.get(f"pr{n}")}
                self._default_branch = (found.get("defaultBranchRef") or {}).get("name")
            except (StackError, ValueError, KeyError, TypeError) as e:
                print(f"warning: couldn't look up pull requests on GitHub, so only checking for merges "
                      f"locally: {e}", file=sys.stderr)
        return self._pull_requests

    def merge_state(self, branch, parent):
        pr = self.pull_requests().get(branch)
        if pr and pr["state"] != "MERGED" and parent == self._default_branch:
            return MergeState.NOT_MERGED
        merge = pr and pr["state"] == "MERGED" and (pr.get("mergeCommit") or {}).get("oid")
        # Trust GitHub only once the merge is in the local parent, so children
        # aren't restacked onto a parent that lacks it, and only if we have the
        # merged commits, so we can tell whether anything came after them.
        if not (merge and rev(merge) and is_ancestor(merge, parent) and rev(pr["headRefOid"])):
            return super().merge_state(branch, parent)
        head = pr["headRefOid"]
        upstream_tip = rev(f"{branch}@{{upstream}}")
        if (unmerged_commits(f"refs/heads/{branch}", head, parent)
                or (upstream_tip and unmerged_commits(upstream_tip, head, parent))):
            return MergeState.MERGED_WITH_NEW_COMMITS
        return MergeState.MERGED

    def after_push(self, branch, branches, parents):
        """Open a draft pull request for branch if it has none, and point the
        open pull requests of the pushed branches at their stack parents."""
        if branch in branches and not config_get(branch, PR_KEY):
            self.record_pull_request(branch, parents[branch])
        prs = self.pull_requests()
        for b in branches:
            pr = prs.get(b)
            if pr and pr["state"] == "OPEN" and pr["baseRefName"] != parents[b]:
                self.gh("pr", "edit", str(pr["number"]), "--repo", self.repo, "--base", parents[b])
                print(f"changed the base of {b}'s pull request #{pr['number']} to {parents[b]}")

    def record_pull_request(self, branch, parent):
        """Record branch's open pull request, opening a draft one if there is none."""
        found = json.loads(self.gh("pr", "list", "--repo", self.repo, "--head", branch,
                                   "--state", "open", "--json", "number"))
        if found:
            number = found[0]["number"]
            print(f"found pull request #{number} for {branch}")
        else:
            url = self.gh("pr", "create", "--repo", self.repo, "--draft", "--base", parent,
                          "--head", branch, "--fill").splitlines()[-1]
            match = re.search(r"/pull/(\d+)$", url)
            if not match:
                raise StackError(f"couldn't tell which pull request gh opened for {branch} from {url!r}")
            number = int(match.group(1))
            print(f"opened draft pull request #{number} for {branch}: {url}")
        config_set(branch, PR_KEY, str(number))


def github_repo(remote):
    """Return (host, owner, name) of remote's repository, or None if its URL isn't one.

    Tries the URL as configured, then with url.<base>.insteadOf applied.
    """
    for url in (git("config", "--get", f"remote.{remote}.url", check=False),
                git("remote", "get-url", remote, check=False)):
        match = REMOTE_URL.match(url)
        if match:
            return match.groups()
    return None


def make_adapter(remote):
    """The adapter stack.adapter asks for. If unset, GitHub's when remote is on
    github.com and gh is installed, and git's otherwise."""
    setting = git("config", "--get", ADAPTER_SETTING, check=False)
    if setting not in ("", "git", "github"):
        raise StackError(f"{ADAPTER_SETTING} must be git or github, not {setting}")
    if setting == "git":
        return GitAdapter()
    repo = github_repo(remote)
    if setting == "github":
        if repo is None:
            raise StackError(f"{ADAPTER_SETTING} is github, but {remote}'s URL isn't a GitHub repository")
        if not shutil.which("gh"):
            raise StackError(f"{ADAPTER_SETTING} is github, which needs the gh CLI on your PATH")
        return GitHubAdapter(*repo)
    if repo and repo[0] == "github.com" and shutil.which("gh"):
        return GitHubAdapter(*repo)
    return GitAdapter()


def drop_from_stack(branch, parents):
    """Move branch's children onto its parent in parents and remove branch.

    Returns the moved children. Only parents is changed, not the config.
    """
    new_parent = parents.pop(branch)
    children = [child for child, parent in parents.items() if parent == branch]
    for child in children:
        parents[child] = new_parent
    return children


def skip_merged(branches, parents, adapter):
    """Leave merged branches out of branches, moving their children down in parents."""
    remaining = []
    for branch in branches:
        parent = parents[branch]
        if adapter.merge_state(branch, parent) is MergeState.MERGED:
            print(f"warning: {branch} looks merged into {parent}; skipping it and moving its "
                  f"children onto {parent}. Run `git stack sync` to remove it from the stack",
                  file=sys.stderr)
            drop_from_stack(branch, parents)
        else:
            remaining.append(branch)
    return remaining


def remote_branch(branch):
    """Return (remote, ref, tip) for branch's upstream on a remote, or None."""
    remote = config_get(branch, "remote")
    ref = config_get(branch, "merge")
    tip = rev(f"{branch}@{{upstream}}")
    if not remote or remote == "." or not ref or tip is None:
        return None
    return remote, ref, tip


def delete_remote_branch(remote, ref, tip):
    """Delete ref on remote, failing if it no longer points at tip."""
    return git_passthrough("push", f"--force-with-lease={ref}:{tip}", remote, f":{ref}")


def untrack(branch):
    for key in (PARENT_KEY, BASE_KEY, PULLED_KEY, PR_KEY, PENDING_PARENT_KEY, PENDING_BASE_KEY,
                PENDING_PULL_FROM_KEY, PENDING_PULLED_KEY):
        config_unset(branch, key)


def remove_merged(branch, parents, delete):
    """Move branch's children onto its parent, then stop tracking branch.

    If delete is set, the branch itself is deleted too.
    """
    new_parent = parents[branch]
    children = drop_from_stack(branch, parents)
    for child in children:
        config_set(child, PARENT_KEY, new_parent)
    moved = f" and moved {', '.join(children)} onto {new_parent}" if children else ""
    if not delete:
        untrack(branch)
        print(f"{branch} was merged into {new_parent}; stopped tracking it{moved}")
        return
    if current_branch() == branch:
        if local_branch_exists(new_parent):
            git("switch", "--quiet", new_parent)
        else:
            git("switch", "--quiet", "--detach", new_parent)
    tip = rev(branch)
    git("branch", "--quiet", "--delete", "--force", branch)
    print(f"{branch} was merged into {new_parent}; deleted it (was {tip[:12]}){moved}")


def cmd_sync(args):
    ensure_no_operation_in_progress()
    ensure_clean_worktree()
    settle_all()
    # Where to leave the user afterwards: their branch, or the commit they had
    # detached at.
    original = current_branch() or rev("HEAD")
    delete_local = args.delete in ("local", "both")
    delete_remote = args.delete in ("remote", "both")
    adapter = make_adapter(args.remote)
    if not git_passthrough("fetch", "--prune", args.remote):
        raise StackError(f"fetching {args.remote} failed")

    parents = tracked_branches()
    roots = sorted({stack_root(b, parents) for b in parents})
    fast_forward_trunks(roots)

    # Parent-before-child, so by the time we reach a branch its parent is
    # final: merged branches have been removed (and their children reparented
    # in `parents`), and the rest have been restacked and pulled.
    order = [b for root in roots for b in descendants(root, children_map(parents))]
    skipped = set()
    for branch in order:
        parent = parents[branch]
        if parent in skipped:
            print(f"warning: skipping {branch} because its parent {parent} was skipped", file=sys.stderr)
            skipped.add(branch)
            continue
        state = adapter.merge_state(branch, parent)
        if state is MergeState.MERGED:
            remote = remote_branch(branch)
            upstream = git("rev-parse", "--abbrev-ref", f"{branch}@{{upstream}}") if remote else None
            if remote and delete_remote:
                if not delete_remote_branch(*remote):
                    print(f"warning: couldn't delete {upstream}; leaving {branch} alone",
                          file=sys.stderr)
                    skipped.add(branch)
                    continue
                print(f"deleted {upstream}")
            remove_merged(branch, parents, delete_local)
            if remote and not delete_remote:
                print(f"note: {upstream} still exists; delete it with "
                      f"`git push {remote[0]} --delete {remote[1].removeprefix('refs/heads/')}`, "
                      f"or pass `--delete remote`")
            if branch == original:
                original = current_branch() or rev("HEAD")
            continue
        if state is MergeState.MERGED_WITH_NEW_COMMITS:
            # Restacking would replay the merged commits onto parent.
            print(f"warning: skipping {branch}: it was merged into {parent}, but it or its remote "
                  f"branch has commits that {parent} doesn't", file=sys.stderr)
            skipped.add(branch)
            continue
        if upstream_gone(branch):
            print(f"warning: {branch}'s remote branch is gone but its changes aren't in {parent}; "
                  f"leaving it alone", file=sys.stderr)
        try:
            restack_branch(branch, parent)
        except BrokenStackError as e:
            print(f"warning: skipping {branch}: {e}", file=sys.stderr)
            skipped.add(branch)
            continue
        pull_upstream(branch, parent)

    if local_branch_exists(original):
        if current_branch() != original:
            git("switch", "--quiet", original)
    elif rev("HEAD") != original or current_branch():
        git("switch", "--quiet", "--detach", original)


def cmd_push(args):
    ensure_no_operation_in_progress()
    settle_all()
    branch = current_branch()
    if branch is None:
        raise StackError("not on a branch")
    parents = tracked_branches()
    if branch not in parents:
        raise StackError(f"{branch} isn't in a stack; switch to a stacked branch to push its stack")
    adapter = make_adapter(args.remote)
    branches = skip_merged(stack_of(branch, parents), parents, adapter)
    if not branches:
        print(f"nothing to push: every branch in {branch}'s stack looks merged")
        return
    # A remote branch deleted since we pushed it was most likely deleted when
    # its pull request was merged, so pushing it again would recreate it.
    for b in branches:
        if upstream_gone(b):
            raise StackError(f"{b}'s remote branch was deleted; run `git stack sync` to stop tracking "
                             f"it if it was merged, or `git branch --unset-upstream {b}` to push it "
                             f"again")

    # Force-pushing is only safe if we've seen everything on the remote branch.
    # Refuse if we know of commits we haven't pulled, and pin each lease to the
    # remote-tracking ref we checked, so a push that raced with someone else's
    # fails instead of overwriting it.
    leases = []
    for b in branches:
        remote_tip = rev(f"refs/remotes/{args.remote}/{b}")
        if remote_tip and unpulled_commits(b, parents[b], remote_tip):
            raise StackError(f"{args.remote}/{b} has commits that {b} doesn't; "
                             f"run `git stack sync` to pull them in first")
        leases.append(f"--force-with-lease={b}:{remote_tip or ''}")
    if not git_passthrough("push", *leases, "--set-upstream", args.remote, *branches):
        raise StackError("push failed; if the remote has new commits, run `git stack sync` and try again")
    try:
        adapter.after_push(branch, branches, parents)
    except StackError as e:
        raise StackError(f"pushed, but updating pull requests failed (set {ADAPTER_SETTING} to git "
                         f"to stop using GitHub): {e}")


def download(url, headers=None, not_found=None):
    """Return the body at url. not_found, if given, is the error for a missing resource."""
    request = urllib.request.Request(url, headers=headers or {})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.read()
    except urllib.error.HTTPError as e:
        e.close()
        # GitHub's commits API answers 422 for a ref that doesn't exist.
        if not_found and e.code in (404, 422):
            raise StackError(not_found)
        raise StackError(f"couldn't download {url}: {e}")
    except OSError as e:
        raise StackError(f"couldn't download {url}: {e}")


def ensure_upgradable(path):
    directory, name = os.path.split(path)
    if git_ok("-C", directory, "ls-files", "--error-unmatch", name):
        raise StackError(f"{path} is tracked by git; update it with `git pull` instead")


def resolve_commit(url, ref):
    """Ask the GitHub API at url which commit ref points to."""
    commit = download(url, {"Accept": "application/vnd.github.sha"},
                      not_found=f"couldn't find a branch, tag or commit named {ref} on GitHub")
    commit = commit.decode().strip()
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise StackError(f"{url} didn't return a commit")
    return commit


def upgrade_file(path, url):
    """Replace the script at path with the one at url. Return whether it changed."""
    directory = os.path.dirname(path)
    new = download(url)
    # Guard against installing an error page or a truncated download.
    try:
        compile(new, url, "exec")
    except (SyntaxError, ValueError):
        raise StackError(f"{url} isn't a valid git-stack script; not installing it")
    with open(path, "rb") as f:
        if f.read() == new:
            return False

    # Write next to the original and rename over it, so an interrupted upgrade
    # never leaves a broken git-stack behind.
    try:
        fd, tmp = tempfile.mkstemp(dir=directory, prefix=".git-stack.")
    except PermissionError:
        raise StackError(f"can't write to {directory}; rerun with permission to write there")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(new)
        os.chmod(tmp, stat.S_IMODE(os.stat(path).st_mode))
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    return True


def cmd_upgrade(args):
    path = os.path.realpath(__file__)
    ensure_upgradable(path)
    commit = resolve_commit(COMMIT_API_URL.format(ref=urllib.parse.quote(args.ref, safe="/")), args.ref)
    if upgrade_file(path, SCRIPT_URL.format(commit=commit)):
        print(f"upgraded {path} to {commit[:12]} ({args.ref})")
    else:
        print(f"already up to date ({args.ref} is {commit[:12]})")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="git stack", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("branch", help="create a new branch stacked on the current one")
    p.add_argument("name")
    p.set_defaults(func=cmd_branch)

    p = sub.add_parser("track", help="track existing branches as a stack on PARENT, each on the "
                                     "one before it (default: the current branch)")
    p.add_argument("parent")
    p.add_argument("branches", nargs="*", metavar="branch",
                   help="branches to stack, bottom first (default: the current branch)")
    p.add_argument("--base", help="commit the first branch was built on (default: merge-base with "
                                  "PARENT). Needed when PARENT has already been squash-merged or "
                                  "rewritten")
    p.set_defaults(func=cmd_track)

    p = sub.add_parser("rename", help="rename a branch (default: the current one), "
                                      "keeping branches stacked on it")
    p.add_argument("old", nargs="?", help="branch to rename (default: the current branch)")
    p.add_argument("name", metavar="new", help="new name")
    p.set_defaults(func=cmd_rename)

    p = sub.add_parser("info", help="show all tracked stacks")
    p.set_defaults(func=cmd_info)

    p = sub.add_parser("restack", help="rebase every branch in the current stack onto its parent")
    p.add_argument("--onto", help="first change the current branch's parent to ONTO")
    p.add_argument("--squash", action="store_true",
                   help="first squash each branch in the stack into a single commit")
    p.set_defaults(func=cmd_restack)

    p = sub.add_parser("sync", help="fetch, untrack merged branches, restack everything, "
                                    "and pull in commits others pushed")
    p.add_argument("--remote", default=DEFAULT_REMOTE)
    p.add_argument("-d", "--delete", choices=("local", "remote", "both"),
                   help="besides untracking merged branches, delete their local branches, "
                        "their remote branches, or both")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("push", help="force-push (with lease) every branch in the current stack, "
                                    "refusing if that would drop commits on the remote")
    p.add_argument("--remote", default=DEFAULT_REMOTE)
    p.set_defaults(func=cmd_push)

    p = sub.add_parser("upgrade", help="replace this script with the latest version from GitHub")
    p.add_argument("--ref", default="main", help="branch, tag or commit to upgrade to (default: main)")
    p.set_defaults(func=cmd_upgrade)

    args = parser.parse_args(argv)
    try:
        args.func(args)
    except StackError as e:
        print(f"git stack: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
